PORT=3000
# Set DATABASE_URL on Render (e.g., Render Free PostgreSQL or Neon connection string).
# Leave blank locally to fall back automatically to data/records.sqlite.
DATABASE_URL=
# Comma-separated browser origins allowed to call this API via CORS (used in Activity 8).
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
